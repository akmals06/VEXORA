# VOXERA — Root Environment Overview
# -----------------------------------------------------------------------------
# Each workspace package manages its own scoped environment variables:
#
# - Frontend (apps/web/.env.example)        : Browser-safe NEXT_PUBLIC_* variables
# - Backend  (apps/api/.env.example)        : Server runtime settings (PORT, CORS_ORIGIN, LOG_LEVEL, SESSION_TTL_DAYS)
# - Database (packages/database/.env.example): PostgreSQL DATABASE_URL for Prisma CLI & Client
#
# Do not store real credentials in this file or commit any .env file to Git.
NODE_ENV=development

