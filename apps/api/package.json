{
  "name": "@voxera/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VOXERA Backend REST API (Express + TypeScript)",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@voxera/contracts": "workspace:*",
    "@voxera/database": "workspace:*",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "@voxera/config": "workspace:*",
    "eslint": "9.39.5",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
