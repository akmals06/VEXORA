{
  "name": "voxera",
  "version": "0.1.0",
  "private": true,
  "description": "VOXERA — Employee Protection and Psychosocial Well-Being Platform",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,cjs,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,cjs,json,md,yaml,yml}\"",
    "db:generate": "pnpm --filter @voxera/database db:generate",
    "db:validate": "pnpm --filter @voxera/database db:validate"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
